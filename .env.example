# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=changeme-generate-your-own-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to use by default.
DJANGO_SETTINGS_MODULE=unleased_project.settings.dev

# Third-party API keys
MAPS_API_KEY=your-maps-api-key-here

# Google OAuth ("Continue with Google"). Create an OAuth client of type
# "Web application" in Google Cloud Console (APIs & Services > Credentials)
# and add BOTH Authorized redirect URIs:
#   http://localhost:8000/accounts/google/login/callback/
#   https://<your-username>.pythonanywhere.com/accounts/google/login/callback/
# Leave these empty to hide the Google button (e.g. before you have keys).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- On PythonAnywhere (production) use values like these instead ----
# SECRET_KEY=<a NEW key, different from your local one>
# ALLOWED_HOSTS=<your-username>.pythonanywhere.com
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: the same pair works on both hosts
# (DJANGO_SETTINGS_MODULE=unleased_project.settings.prod is set in the
#  PythonAnywhere WSGI file, not here.)

# AI listing assistant (A6 Part 2) - all optional.
# Local Hugging Face model; weights download on first use (torch + transformers from requirements.txt).
# LOCAL_LLM_MODEL=ibm-granite/granite-4.0-micro   (about 7 GB; Qwen/Qwen2.5-1.5B-Instruct is a ~3 GB alternative)
# LOCAL_LLM_DEVICE=auto    (cuda, then mps, then cpu; or set one explicitly)
# Google Gemini API key (free tier): https://aistudio.google.com/apikey
# Without it the page still works and uses a template description instead.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_THINKING_LEVEL=low
