# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=changeme-generate-your-own-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to use by default.
DJANGO_SETTINGS_MODULE=unleased_project.settings.dev

# Third-party API keys
MAPS_API_KEY=your-maps-api-key-here
