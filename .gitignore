# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ---- Virtual environments ----
venv/
env/
.venv/
ENV/

# ---- Django ----
# The database holds real user accounts once people sign up on production,
# so it is no longer committed (it was only committed for the A4 initial
# deploy). Every machine keeps its own copy; use seed_data.py locally.
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/
*.log

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- LLM model weights (INFO 490 A6) ----
# Hugging Face caches/downloads these locally via transformers; multi-GB
# binary weight files must never be committed, only the notebook/code that
# fetches them.
*.bin
*.safetensors
*.pt
*.gguf
*.onnx
llm-test/models/
llm-test/.cache/
huggingface_cache/

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- OS cruft ----
.DS_Store
.Rhistory
Thumbs.db
